generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Roles del sistema que se persisten en DB: ADMINISTRADOR (3), PRECEPTOR (2) y DOCENTE (1).
/// El Visitante no tiene rol en la DB: es todo usuario sin sesión (accede solo al sitio público).
/// `nivel` codifica la jerarquía (Admin > Preceptor > Docente) y se usa para validar
/// reglas de creación de usuarios (RF-13/RF-14).
model Rol {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  nivel     Int       @unique
  descripcion String?
  usuarios  Usuario[]

  @@map("roles")
}

/// Usuario del sistema. Puede tener rol ADMINISTRADOR, PRECEPTOR o DOCENTE.
/// `activo` permite desactivar un usuario e impedir que inicie sesión (RF-15).
model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  apellido  String
  email     String   @unique
  passwordHash String
  activo    Boolean  @default(true)
  rolId     Int
  rol       Rol      @relation(fields: [rolId], references: [id])
  cursosAsignados CursoDocente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rolId])
  @@map("usuarios")
}

/// Curso de la oferta educativa. Información mínima según sección 7 del documento
/// (nombre, descripción, modalidad, horarios, meses de cursada, fecha de inicio,
/// docente y programa/contenidos), más campos opcionales sugeridos.
model Curso {
  id        Int      @id @default(autoincrement())
  nombre    String
  descripcion String?
  modalidad String?
  horarios  String?
  mesesCursada String?
  fechaInicio DateTime?
  fechaFin   DateTime?
  sede       String?
  enlaceInscripcion String?
  programaContenidos String?
  /// HTML ya sanitizado del editor enriquecido del panel. Si viene, se renderiza
  /// en el detalle público; si no, se usa `programaContenidos` en texto plano.
  programaContenidosHtml String?
  categoria String?
  /// Emoji/ícono opcional cargado desde el panel. Si viene vacío, el sitio usa
  /// uno automático según la categoría (iconoCurso con fallback a iconoCategoria).
  emoji     String?
  cupos     Int?
  imagenUrl String?
  informacionAdicional String?
  activo    Boolean  @default(true)

  docentes  CursoDocente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cursos")
}

/// Tabla intermedia que relaciona un curso con uno o más docentes asignados (RF-11).
/// Un Docente solo puede gestionar los cursos que figuren aquí (RF-16).
model CursoDocente {
  cursoId   Int
  curso     Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  docenteId Int
  docente   Usuario @relation(fields: [docenteId], references: [id], onDelete: Restrict)

  @@id([cursoId, docenteId])
  @@index([docenteId])
  @@map("cursos_docentes")
}

/// Imagen subida desde el panel (cursos y noticias). Se guarda en la base como
/// bytes y se sirve por /api/imagenes/[id]. En Curso.imagenUrl y
/// Noticia.imagenUrl se persiste esa URL interna (o una URL externa heredada).
model Imagen {
  id        Int      @id @default(autoincrement())
  nombre    String
  mimeType  String
  tamano    Int
  datos     Bytes
  createdAt DateTime @default(now())

  @@map("imagenes")
}

/// Noticia institucional publicada en el sitio público (RF-17). Se administra
/// desde el panel por Administrador y Preceptor. `activo` controla si se
/// muestra en el listado y detalle públicos.
model Noticia {
  id        Int      @id @default(autoincrement())
  titulo    String
  resumen   String?
  contenido String
  /// HTML ya sanitizado que produce el editor de texto enriquecido del panel.
  /// Si viene, se renderiza en el detalle público; si no, se usa `contenido`
  /// en texto plano (RF-17). Se guarda únicamente sanitizado en el servidor.
  contenidoHtml String?
  fecha     DateTime
  imagenUrl String?
  activo    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("noticias")
}

/// Contenido de la página pública "Sobre el centro". Se persiste en una única
/// fila (el panel la edita completa). Las secciones son opcionales: si una
/// sección no está cargada, no se muestra en la vista pública.
/// `hitos` = [{ anio, titulo, texto }], `estadisticas` = [{ valor, etiqueta }],
/// `galeria` = [{ url, leyenda }] (url interna `/api/imagenes/<id>`).
model SobreElCentro {
  id             Int      @id @default(autoincrement())
  intro          String?
  /// HTML sanitizado del editor enriquecido para `intro`.
  introHtml      String?
  misionTitulo   String?
  misionTexto    String?
  /// HTML sanitizado del editor enriquecido para `misionTexto`.
  misionTextoHtml String?
  historiaTitulo String?
  historiaTexto  String?
  /// HTML sanitizado del editor enriquecido para `historiaTexto`.
  historiaTextoHtml String?
  hitos          Json?
  estadisticasTitulo String?
  estadisticas   Json?
  galeriaTitulo  String?
  galeria        Json?
  activo         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sobre_el_centro")
}

/// Categoría que agrupa preguntas frecuentes. Una categoría sin preguntas
/// activas no se muestra en la vista pública.
model CategoriaPregunta {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  orden     Int?
  activo    Boolean  @default(true)
  preguntas PreguntaFrecuente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categorias_preguntas")
}

/// Pregunta frecuente de la página pública `/preguntas-frecuentes`. `activo`
/// controla si se muestra; las preguntas se ordenan por `orden` dentro de su
/// categoría.
model PreguntaFrecuente {
  id          Int              @id @default(autoincrement())
  pregunta    String
  respuesta   String
  /// HTML sanitizado del editor enriquecido de la respuesta. Si viene, se
  /// renderiza en la vista pública; si no, se usa `respuesta` en texto plano.
  respuestaHtml String?
  categoriaId Int
  categoria   CategoriaPregunta @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  orden       Int?
  activo      Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoriaId])
  @@map("preguntas_frecuentes")
}

/// Contenido textual editable de la guía general de inscripción (RF-05).
/// Cada registro corresponde a un bloque temático (pasos, documentación,
/// requisitos, información adicional). El contenido proviene de la BD,
/// no de texto fijo en el código.
model ContenidoGuia {
  id        Int      @id @default(autoincrement())
  clave     String   @unique
  titulo    String
  contenido String
  /// HTML sanitizado del editor enriquecido del bloque. Si viene, se renderiza
  /// en la guía pública; si no, se usa `contenido` en texto plano.
  contenidoHtml String?
  orden     Int?
  activo    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contenidos_guia")
}

/// Configuración editable del sitio público (banner azul, logo, footer y contactos).
/// Fila única (id=1) editada desde el panel por ADMINISTRADOR y PRECEPTOR.
/// Creado por sofia-athos para requerimiento Joaquín 22/9/2026: banner + logo + footer + contactos editables.
model SiteConfig {
  id Int @id @default(autoincrement())

  // Banner azul front page
  bannerPill      String? // ej: "Preinscripción 2026 abierta"
  bannerTitulo    String? // ej: "Capacitate en un oficio, gratis y cerca de casa."
  bannerSubtitulo String? // texto lead
  bannerImagenUrl String? // url externa o /api/imagenes/<id>

  // Logo
  logoUrl String? // ej: "/cfl401azul_logo.jpg" o /api/imagenes/<id>
  logoAlt String? // alt del logo

  // Footer
  footerCflTitulo String? // "CFL 401 Azul"
  footerCflTexto  String? // párrafo debajo de CFL 401 Azul
  footerContactosTitulo String? // "Contacto"
  footerEmail     String?
  footerTelefono  String?
  footerDireccion String?
  footerHorarios  String?
  footerCopy      String? // "© 2026 CFL 401 — Azul"

  // Sección Contacto (página /contacto)
  contactoTitulo    String?
  contactoSubtitulo String?
  contactoEmail     String?
  contactoTelefono  String?
  contactoDireccion String?
  contactoHorarios  String?
  contactoFormDestinatario String? // email donde llegan consultas

  // Ubicación (mapa de Google en la portada)
  mapaUrl String? // src del iframe embed de Google Maps ("Compartir → Insertar un mapa")
  mapaTitulo String? // título del bloque, ej: "¿Dónde estamos?"
  mapaSubtitulo String? // texto bajo el título (dirección/sede, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_config")
}